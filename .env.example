# Variables opcionales al publicar el sitio. Ninguna es secreta.

# Ruta pública: "/" para un dominio o subdominio propio; "/menu-digital/" si va dentro de otra ruta.
VITE_BASE_PATH=/

# Enlace a la carpeta donde se sube menu.xlsx (por ejemplo la carpeta «public» del
# repositorio en GitHub). Si se define, el panel /admin/ muestra un botón para ir ahí.
VITE_UPDATE_URL=
